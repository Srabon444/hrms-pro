{
	"name": "hrms-pro",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run --project unit",
		"test:int": "vitest run --project integration",
		"test:e2e": "playwright test",
		"test:all": "npm run test && npm run test:int && npm run test:e2e",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx src/cli.ts migrate",
		"cli": "tsx src/cli.ts",
		"infra:up": "docker compose up -d postgres redis minio mailpit",
		"infra:down": "docker compose down",
		"worker": "node --import tsx src/worker.ts",
		"db:seed": "tsx src/cli.ts seed"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-node": "6.0.2",
		"@sveltejs/kit": "3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.5",
		"@types/nodemailer": "^8.0.2",
		"@types/pdfkit": "^0.17.7",
		"drizzle-kit": "^0.31.11",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"svelte": "~5.57.3",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.5",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "~8.2.6",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1175.0",
		"@fontsource/noto-sans-bengali": "^5.3.0",
		"@node-rs/argon2": "^2.2.2",
		"arctic": "^3.7.0",
		"bullmq": "^5.81.6",
		"chart.js": "^4.5.1",
		"drizzle-orm": "^0.45.4",
		"html-to-image": "^1.11.13",
		"ioredis": "^5.11.1",
		"jspdf": "^4.2.1",
		"nodemailer": "~10.3.1",
		"pdfkit": "^0.17.2",
		"pino": "^10.4.0",
		"postgres": "^3.4.9",
		"prom-client": "^15.1.3",
		"zod": "^4.6.7"
	},
	"engines": {
		"node": ">=24"
	},
	"overrides": {
		"source-map-js": "1.2.2"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
